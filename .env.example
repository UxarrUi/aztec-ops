# Base de datos local. SQLite en archivo: no hace falta levantar nada.
DATABASE_URL="file:./prisma/dev.db"

# Fecha de corte del sistema (YYYY-MM-DD).
# El dataset es un snapshot del ~13-jul-2026; con la fecha real de hoy, 13 de 22
# proyectos salen vencidos y el tablero pierde señal. Por defecto se usa la fecha
# del snapshot. También se puede cambiar desde la interfaz.
AS_OF_DATE="2026-07-13"

# OPCIONAL. Sin esta clave el sistema funciona completo: la redacción asistida
# cae a plantillas deterministas. La IA solo redacta — nunca decide prioridades.
# ANTHROPIC_API_KEY="sk-ant-..."
